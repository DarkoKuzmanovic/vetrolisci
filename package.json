{
  "name": "vetrolisci",
  "version": "2.0.1",
  "description": "Multiplayer Vetrolisci (Pixies) card duel built with React and Socket.IO",
  "type": "module",
  "main": "src/server/main.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node src/server/main.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node scripts/lint.mjs",
    "smoke": "npm run build",
    "premerge": "npm run lint && npm run smoke"
  },
  "dependencies": {
    "express": "^4.18.2",
    "framer-motion": "^12.23.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "concurrently": "^8.2.0",
    "vite": "^4.4.5"
  },
  "author": "Darko Kuzmanovic",
  "license": "MIT"
}
